<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/permission_request_dialog_width"
    android:layout_height="wrap_content"
    android:layout_marginRight="@dimen/permission_request_dialog_horizontal_margin"
    android:layout_marginLeft="@dimen/permission_request_dialog_horizontal_margin"
    android:layout_marginBottom="@dimen/permission_request_dialog_vertical_margin"
    android:orientation="vertical" >

    <ImageView
        android:id="@+id/dialog_permission_icon"
        android:tint="@color/colorAccent"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="18dp"
        android:layout_centerHorizontal="true" />

    <TextView
        android:id="@+id/dialog_message"
        android:layout_below="@id/dialog_permission_icon"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="22dp"
        android:gravity="center"
        android:textColor="#1A1B21"
        android:textSize="20sp"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />

    <Button
        android:id="@+id/dialog_button_allow"
        android:layout_below="@id/dialog_message"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/permission_request_dialog_button_height"
        android:layout_marginTop="@dimen/permission_request_dialog_button_internal_spacing"
        android:text="@string/permission_manage_allow"
        android:textSize="@dimen/permission_request_dialog_button_text_size"
        android:textColor="#1A1B21"
        android:textAllCaps="false"
        android:background="@drawable/top_button_background"
        android:stateListAnimator="@null"
        android:gravity="center" />

    <Button
        android:id="@+id/dialog_button_only_once"
        android:layout_below="@id/dialog_button_allow"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/permission_request_dialog_button_height"
        android:layout_marginTop="@dimen/permission_request_dialog_button_internal_spacing"
        android:text="@string/permission_manage_only_once"
        android:textSize="@dimen/permission_request_dialog_button_text_size"
        android:textColor="#1A1B21"
        android:textAllCaps="false"
        android:background="@drawable/center_button_background"
        android:stateListAnimator="@null"
        android:gravity="center" />

    <Button
        android:id="@+id/dialog_button_do_not_allow"
        android:layout_below="@id/dialog_button_only_once"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/permission_request_dialog_button_height"
        android:layout_marginTop="@dimen/permission_request_dialog_button_internal_spacing"
        android:text="@string/permission_manage_do_not_allow"
        android:textSize="@dimen/permission_request_dialog_button_text_size"
        android:textColor="#1A1B21"
        android:textAllCaps="false"
        android:background="@drawable/bottom_button_background"
        android:stateListAnimator="@null"
        android:gravity="center" />

</RelativeLayout>
